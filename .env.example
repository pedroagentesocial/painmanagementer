# Lead notifications — all optional. Without them the lead action just logs to
# the console (the site still runs). Copy this file to `.env` and fill what you use.

# Resend (https://resend.com) — email notifications
RESEND_API_KEY=
# Must be a verified sender/domain in your Resend account, e.g. "Leads <leads@tudominio.com>"
LEAD_EMAIL_FROM=
# Where lead emails are delivered, e.g. "recepcion@tuclinica.com"
LEAD_EMAIL_TO=

# Webhook — POST the lead as JSON to a CRM / Make / Zapier endpoint
LEAD_WEBHOOK_URL=
