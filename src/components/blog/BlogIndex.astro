---
import { getLangFromUrl, useTranslations, useTranslatedPath } from '../../i18n/utils';
import { getPosts, postSlug, readingMinutes, formatDate } from '../../lib/blog';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const localize = useTranslatedPath(lang);
const posts = await getPosts(lang);
---

<section class="mx-auto max-w-6xl px-5 pb-24 pt-32 sm:px-8 sm:pt-36">
  <header class="max-w-2xl">
    <p class="font-display text-sm font-semibold uppercase tracking-[0.2em] text-clay-600">
      {t.blog.eyebrow}
    </p>
    <h1 class="font-display mt-4 text-[clamp(2.2rem,5.5vw,3.5rem)] font-bold text-ink">
      {t.blog.title}
    </h1>
    <p class="mt-5 text-lg leading-relaxed text-ink-soft">{t.blog.subtitle}</p>
  </header>

  {
    posts.length === 0 ? (
      <p class="mt-14 text-ink-soft">{t.blog.empty}</p>
    ) : (
      <ul role="list" class="mt-14 grid gap-6 sm:grid-cols-2">
        {posts.map((post, i) => (
          <li class="reveal" style={`--reveal-delay:${(i % 2) * 70}ms`}>
            <a
              href={localize(`blog/${postSlug(post)}`)}
              class="group flex h-full flex-col rounded-3xl border border-ink/8 bg-paper-2 p-7 shadow-soft transition-[transform,box-shadow,border-color] duration-200 hover:-translate-y-1 hover:border-clay-300 hover:shadow-lift sm:p-8"
            >
              {post.data.tags.length > 0 && (
                <ul role="list" class="flex flex-wrap gap-2">
                  {post.data.tags.slice(0, 3).map((tag) => (
                    <li class="rounded-full bg-clay-50 px-3 py-1 text-xs font-semibold text-clay-700">{tag}</li>
                  ))}
                </ul>
              )}
              <h2 class="font-display mt-5 text-2xl leading-tight text-ink transition-colors group-hover:text-clay-700">
                {post.data.title}
              </h2>
              <p class="mt-3 flex-1 leading-relaxed text-ink-soft">{post.data.description}</p>
              <p class="mt-6 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-ink-faint">
                <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate, lang)}</time>
                <span aria-hidden="true">·</span>
                <span>
                  {readingMinutes(post)} {t.blog.minRead}
                </span>
              </p>
              <span class="mt-5 inline-flex items-center gap-2 text-sm font-semibold text-clay-700">
                {t.blog.readMore}
                <span aria-hidden="true" class="transition-transform duration-200 group-hover:translate-x-1">→</span>
              </span>
            </a>
          </li>
        ))}
      </ul>
    )
  }
</section>
