---
import { render } from 'astro:content';
import { getLangFromUrl, useTranslations, useTranslatedPath } from '../../i18n/utils';
import { readingMinutes, formatDate, type BlogPost } from '../../lib/blog';

interface Props {
  post: BlogPost;
}

const { post } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const localize = useTranslatedPath(lang);
const { Content } = await render(post);
const { title, description, pubDate, updatedDate, author, tags, sources } = post.data;
---

<article class="mx-auto max-w-3xl px-5 pb-24 pt-32 sm:px-8 sm:pt-36">
  <a
    href={localize('blog')}
    class="link-underline inline-flex items-center gap-2 text-sm font-semibold text-clay-700"
  >
    <span aria-hidden="true">←</span>
    {t.blog.backToBlog}
  </a>

  <header class="mt-6">
    {
      tags.length > 0 && (
        <ul role="list" class="flex flex-wrap gap-2">
          {tags.map((tag) => (
            <li class="rounded-full bg-clay-50 px-3 py-1 text-xs font-semibold text-clay-700">{tag}</li>
          ))}
        </ul>
      )
    }
    <h1 class="font-display mt-5 text-[clamp(2rem,5vw,3.1rem)] font-bold leading-[1.05] text-ink">{title}</h1>
    <p class="mt-5 text-lg leading-relaxed text-ink-soft">{description}</p>
    <p class="mt-6 flex flex-wrap items-center gap-x-3 gap-y-1 border-b border-ink/10 pb-6 text-sm text-ink-faint">
      <span>{author}</span>
      <span aria-hidden="true">·</span>
      <span>
        {t.blog.published} <time datetime={pubDate.toISOString()}>{formatDate(pubDate, lang)}</time>
      </span>
      {
        updatedDate && (
          <>
            <span aria-hidden="true">·</span>
            <span>
              {t.blog.updated} <time datetime={updatedDate.toISOString()}>{formatDate(updatedDate, lang)}</time>
            </span>
          </>
        )
      }
      <span aria-hidden="true">·</span>
      <span>{readingMinutes(post)} {t.blog.minRead}</span>
    </p>
  </header>

  <div class="prose-blog mt-10">
    <Content />
  </div>

  <aside class="mt-14 rounded-2xl border border-ochre-300 bg-ochre-100 p-6 text-sm leading-relaxed text-ink-soft">
    <p class="font-semibold text-ink">{t.blog.disclaimerTitle}</p>
    <p class="mt-2">{t.blog.disclaimer}</p>
  </aside>

  <section class="mt-12" aria-labelledby="sources-title">
    <h2 id="sources-title" class="font-display text-xl font-bold text-ink">{t.blog.sourcesTitle}</h2>
    <ol class="mt-4 list-decimal space-y-3 pl-5 text-sm leading-relaxed text-ink-soft marker:text-ink-faint">
      {
        sources.map((source) => (
          <li>
            <a
              href={source.url}
              target="_blank"
              rel="noopener noreferrer"
              class="font-medium text-clay-700 underline decoration-clay-300 underline-offset-2 hover:decoration-clay-700"
            >
              {source.title}
            </a>
            . {source.publisher}
            {source.date && <>, {source.date}</>}.
          </li>
        ))
      }
    </ol>
  </section>

  <section class="surface-espresso mt-14 rounded-3xl p-8 text-paper sm:p-10">
    <h2 class="font-display text-2xl">{t.blog.ctaTitle}</h2>
    <p class="on-dark mt-3 text-paper/80">{t.blog.ctaText}</p>
    <a
      href={`${localize()}#contact`}
      class="mt-7 inline-flex min-h-12 items-center rounded-full bg-clay-600 px-7 text-base font-semibold text-paper shadow-sm transition-[background-color,transform] duration-200 hover:-translate-y-0.5 hover:bg-clay-700"
    >
      {t.blog.ctaButton}
    </a>
  </section>
</article>
