---
/**
 * Renders a bespoke icon from the project icon set with a shared SVG shell,
 * so stroke weight, grid and joins stay consistent everywhere.
 */
interface Props {
  paths: string;
  class?: string;
}
const { paths, class: cls = 'h-6 w-6' } = Astro.props;
---

<svg
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={cls}
  aria-hidden="true"
  set:html={paths}
/>
