---
import { getLangFromUrl, useTranslations, useTranslatedPath } from '../../i18n/utils';
import Icon from '../visual/Icon.astro';
import { serviceIcons } from '../../icons';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const localize = useTranslatedPath(lang);
---

<section id="treatments" class="scroll-mt-24 py-20 lg:py-28">
  <div class="mx-auto max-w-6xl px-5 sm:px-8">
    <div class="reveal max-w-2xl">
      <p class="flex items-center gap-3 text-sm font-semibold uppercase tracking-[0.16em] text-clay-700">
        <span class="h-px w-8 bg-clay-500" aria-hidden="true"></span>
        {t.treatments.eyebrow}
      </p>
      <h2 class="font-display mt-5 text-[clamp(2.2rem,5.5vw,4rem)] font-bold text-ink">
        {t.treatments.title}
      </h2>
      <p class="mt-5 text-lg text-ink-soft">{t.treatments.subtitle}</p>
    </div>

    <div
      id="treatments-showcase"
      class="reveal mt-12 grid gap-5 lg:grid-cols-[0.92fr_1.08fr] lg:gap-10"
    >
      {/* Left: selectable list */}
      <div role="tablist" aria-label={t.treatments.eyebrow} class="flex flex-col gap-2">
        {
          t.treatments.items.map((item, i) => (
            <button
              type="button"
              role="tab"
              id={`tx-tab-${i}`}
              aria-controls={`tx-panel-${i}`}
              aria-selected={i === 0 ? 'true' : 'false'}
              class="tx-item group flex items-center gap-4 rounded-2xl border border-transparent px-4 py-4 text-left transition-[background-color,border-color,box-shadow] duration-200"
            >
              <span class="tx-num font-display text-sm font-bold text-ink-faint">
                {String(i + 1).padStart(2, '0')}
              </span>
              <span class="tx-ic flex h-11 w-11 flex-none items-center justify-center rounded-xl bg-clay-50 text-clay-600 ring-1 ring-clay-100 transition-colors duration-200">
                <Icon paths={serviceIcons[i]} class="h-6 w-6" />
              </span>
              <span class="flex-1 font-semibold text-ink">{item.title}</span>
              <span class="tx-arrow flex-none text-clay-600" aria-hidden="true">→</span>
            </button>
          ))
        }
      </div>

      {/* Right: detail panel */}
      <div class="relative min-h-[24rem]">
        {
          t.treatments.items.map((item, i) => (
            <div
              role="tabpanel"
              id={`tx-panel-${i}`}
              aria-labelledby={`tx-tab-${i}`}
              hidden={i !== 0}
              class="tx-panel rounded-3xl border border-ink/10 bg-paper p-7 shadow-[var(--shadow-lift)] sm:p-9"
            >
              <div class="flex flex-wrap items-center gap-3">
                <span class="flex h-16 w-16 flex-none items-center justify-center rounded-2xl bg-clay-50 text-clay-600 ring-1 ring-clay-100">
                  <Icon paths={serviceIcons[i]} class="h-8 w-8" />
                </span>
                <span class="rounded-full bg-clay-50 px-3 py-1 text-xs font-semibold uppercase tracking-wide text-clay-700 ring-1 ring-clay-100">
                  {item.tag}
                </span>
              </div>

              <h3 class="font-display mt-5 text-2xl font-bold text-ink">{item.title}</h3>
              <p class="mt-3 leading-relaxed text-ink-soft">{item.description}</p>

              <ul role="list" class="mt-5 space-y-3">
                {item.points.map((point) => (
                  <li class="flex items-start gap-3 text-sm text-ink">
                    <span class="mt-0.5 flex h-5 w-5 flex-none items-center justify-center rounded-full bg-clay-50 text-clay-600 ring-1 ring-clay-100" aria-hidden="true">
                      <svg viewBox="0 0 24 24" class="h-3 w-3" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M5 13l4 4L19 7" />
                      </svg>
                    </span>
                    {point}
                  </li>
                ))}
              </ul>

              <a
                href={`${localize()}#contact`}
                class="group mt-7 inline-flex items-center gap-2 rounded-full bg-clay-600 px-6 py-3.5 text-base font-semibold text-paper shadow-sm transition-[background-color,transform] duration-200 hover:-translate-y-0.5 hover:bg-clay-700 active:translate-y-0"
              >
                {t.treatments.cta}
                <span class="transition-transform group-hover:translate-x-1" aria-hidden="true">→</span>
              </a>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .tx-item:hover {
    background-color: color-mix(in srgb, var(--color-paper-2) 70%, transparent);
  }
  .tx-item[aria-selected='true'] {
    background-color: var(--color-paper-2);
    border-color: var(--color-clay-200);
    box-shadow: var(--shadow-soft);
  }
  .tx-item[aria-selected='true'] .tx-num {
    color: var(--color-clay-600);
  }
  .tx-item[aria-selected='true'] .tx-ic {
    background-color: var(--color-clay-600);
    color: var(--color-paper);
  }
  .tx-arrow {
    opacity: 0;
    transform: translateX(-4px);
    transition:
      opacity 200ms ease,
      transform 200ms ease;
  }
  .tx-item[aria-selected='true'] .tx-arrow {
    opacity: 1;
    transform: translateX(0);
  }

  .tx-anim {
    animation: tx-fade 360ms var(--ease-out-quart, ease);
  }
  @keyframes tx-fade {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .tx-anim {
      animation: none;
    }
  }
</style>

<script>
  // Treatments showcase: a list selects which detail panel shows. Hover previews
  // on pointer devices, click/tap everywhere, arrow keys for keyboard users.
  function initTreatments() {
    const root = document.getElementById('treatments-showcase');
    if (!root || root.dataset.bound === '1') return;
    root.dataset.bound = '1';

    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
    const panels = Array.from(root.querySelectorAll<HTMLElement>('[role="tabpanel"]'));
    const canHover = window.matchMedia('(hover: hover)').matches;

    const activate = (i: number) => {
      tabs.forEach((tab, ti) => tab.setAttribute('aria-selected', ti === i ? 'true' : 'false'));
      panels.forEach((panel, pi) => {
        if (pi === i) {
          panel.hidden = false;
          panel.classList.remove('tx-anim');
          void panel.offsetWidth; // restart the fade
          panel.classList.add('tx-anim');
        } else {
          panel.hidden = true;
        }
      });
    };

    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => activate(i));
      if (canHover) tab.addEventListener('mouseenter', () => activate(i));
      tab.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowDown' || e.key === 'ArrowRight') {
          e.preventDefault();
          const n = (i + 1) % tabs.length;
          tabs[n].focus();
          activate(n);
        } else if (e.key === 'ArrowUp' || e.key === 'ArrowLeft') {
          e.preventDefault();
          const n = (i - 1 + tabs.length) % tabs.length;
          tabs[n].focus();
          activate(n);
        }
      });
    });
  }

  document.addEventListener('astro:page-load', initTreatments);
</script>
