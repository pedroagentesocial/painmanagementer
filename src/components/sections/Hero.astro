---
import { getLangFromUrl, useTranslations, useTranslatedPath } from '../../i18n/utils';
import HeroGraphic from '../visual/HeroGraphic.astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const localize = useTranslatedPath(lang);
---

<section class="relative overflow-hidden">
  {/* Warm glow anchored behind the type */}
  <div
    class="pointer-events-none absolute -left-48 -top-48 h-[40rem] w-[40rem] rounded-full opacity-70 blur-3xl"
    style="background: radial-gradient(circle, var(--color-clay-100), transparent 70%)"
    aria-hidden="true"
  >
  </div>

  <div
    class="relative mx-auto grid max-w-6xl items-center gap-12 px-5 pb-16 pt-12 sm:px-8 lg:grid-cols-[1.1fr_0.9fr] lg:gap-16 lg:pb-28 lg:pt-20"
  >
    <div>
      <p class="reveal flex items-center gap-3 text-sm font-semibold uppercase tracking-[0.16em] text-clay-700">
        <span class="h-px w-8 bg-clay-500" aria-hidden="true"></span>
        {t.hero.eyebrow}
      </p>

      <h1
        class="reveal font-display mt-6 text-[clamp(2.9rem,8.5vw,6.5rem)] font-extrabold text-ink"
        style="--reveal-delay:60ms; line-height:0.92"
      >
        {t.hero.titleA}
        <span class="relative mt-1 inline-block pb-3 text-clay-600">
          {t.hero.titleB}
          {/* Hand-drawn-style underline: type treated as graphic */}
          <svg
            class="absolute bottom-1 left-0 w-full"
            viewBox="0 0 300 12"
            preserveAspectRatio="none"
            fill="none"
            aria-hidden="true"
            style="height:0.2em"
          >
            <path
              d="M3 8c60-6 130-7 210-4 30 1 58 3 84 5"
              stroke="var(--color-ochre-400)"
              stroke-width="5"
              stroke-linecap="round"
            ></path>
          </svg>
        </span>
      </h1>

      <p
        class="reveal mt-7 max-w-xl text-lg leading-relaxed text-ink-soft sm:text-xl"
        style="--reveal-delay:120ms"
      >
        {t.hero.subtitle}
      </p>

      <div
        class="reveal mt-9 flex flex-col gap-3 sm:flex-row sm:items-center"
        style="--reveal-delay:180ms"
      >
        <a
          href={`${localize()}#contact`}
          class="rounded-full bg-clay-600 px-8 py-4 text-center text-base font-semibold text-paper shadow-lg shadow-clay-900/15 transition-[background-color,transform,box-shadow] duration-200 hover:-translate-y-0.5 hover:bg-clay-700 hover:shadow-xl hover:shadow-clay-900/20 active:translate-y-0"
        >
          {t.hero.ctaPrimary}
        </a>
        <a
          href={`${localize()}#treatments`}
          class="group inline-flex items-center justify-center gap-2 px-3 py-4 text-base font-semibold text-ink underline-offset-4 transition-colors hover:text-clay-700 hover:underline"
        >
          {t.hero.ctaSecondary}
          <span class="transition-transform group-hover:translate-x-1" aria-hidden="true">→</span>
        </a>
      </div>

      <p class="reveal mt-9 text-sm font-medium text-ink-faint" style="--reveal-delay:240ms">
        {t.hero.trust}
      </p>
    </div>

    <HeroGraphic />
  </div>
</section>
