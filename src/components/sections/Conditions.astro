---
import { getLangFromUrl, useTranslations, useTranslatedPath } from '../../i18n/utils';
import Icon from '../visual/Icon.astro';
import { conditionIcons } from '../../icons';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const localize = useTranslatedPath(lang);
---

<section id="conditions" class="scroll-mt-24 bg-paper-2 py-20 lg:py-28">
  <div class="mx-auto grid max-w-6xl gap-10 px-5 sm:px-8 lg:grid-cols-[0.85fr_1.15fr] lg:gap-14">
    {/* Intro + reassurance (sticky on desktop) */}
    <div class="reveal lg:sticky lg:top-28 lg:self-start">
      <p class="flex items-center gap-3 text-sm font-semibold uppercase tracking-[0.16em] text-clay-700">
        <span class="h-px w-8 bg-clay-500" aria-hidden="true"></span>
        {t.conditions.eyebrow}
      </p>
      <h2 class="font-display mt-5 text-[clamp(2.2rem,5.5vw,4rem)] font-bold text-ink">
        {t.conditions.title}
      </h2>
      <p class="mt-5 max-w-md text-lg text-ink-soft">{t.conditions.subtitle}</p>

      <div class="mt-8 rounded-2xl border border-ink/10 bg-paper p-5 shadow-[var(--shadow-soft)]">
        <h3 class="font-display text-base font-bold text-ink">{t.conditions.notListedTitle}</h3>
        <p class="mt-1.5 text-sm leading-relaxed text-ink-soft">{t.conditions.notListedText}</p>
        <a
          href={`${localize()}#contact`}
          class="group mt-4 inline-flex items-center gap-2 text-sm font-semibold text-clay-700 transition-colors hover:text-clay-600"
        >
          {t.conditions.notListedCta}
          <span class="transition-transform duration-200 group-hover:translate-x-1" aria-hidden="true">→</span>
        </a>
      </div>
    </div>

    {/* Flip-card grid: front = icon + title · flip = details */}
    <ul role="list" class="grid gap-5 sm:grid-cols-2">
      {
        t.conditions.items.map((item, i) => (
          <li class="reveal flip-card" style={`--reveal-delay:${(i % 2) * 80}ms`}>
            <div class="flip-card-inner">
              {/* Resting face */}
              <div class="flip-rest">
                <div class="flip-rest-content">
                  <span class="blob blob-a" aria-hidden="true" />
                  <span class="blob blob-b" aria-hidden="true" />
                  <span class="flip-icon">
                    <Icon paths={conditionIcons[i]} class="h-10 w-10" />
                  </span>
                  <h3 class="flip-title font-display">{item.title}</h3>
                  <span class="flip-hint" aria-hidden="true">
                    <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M3 12a9 9 0 1 0 9-9 9.7 9.7 0 0 0-6.7 2.8L3 8" />
                      <path d="M3 3v5h5" />
                    </svg>
                  </span>
                </div>
              </div>

              {/* Flipped face */}
              <div class="flip-info">
                <h3 class="flip-info-title font-display">{item.title}</h3>
                <p class="flip-info-desc">{item.description}</p>
                <a href={`${localize()}#contact`} class="flip-info-cta">
                  {t.conditions.notListedCta}
                  <span aria-hidden="true">→</span>
                </a>
              </div>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .flip-card {
    perspective: 1200px;
    height: 16rem;
  }
  .flip-card-inner {
    position: relative;
    height: 100%;
    width: 100%;
    transform-style: preserve-3d;
    transition: transform 600ms var(--ease-out-quart, ease);
    border-radius: 1rem;
  }

  /* Flip triggers: hover/keyboard focus on pointer devices, tap on touch.
     Pointer-events are gated to the visible face so the back link is clickable
     (a hidden front face must not swallow the click). */
  .flip-rest {
    pointer-events: auto;
  }
  .flip-info {
    pointer-events: none;
  }
  @media (hover: hover) {
    .flip-card:hover .flip-card-inner,
    .flip-card:focus-within .flip-card-inner {
      transform: rotateY(180deg);
    }
    .flip-card:hover .flip-info,
    .flip-card:focus-within .flip-info {
      pointer-events: auto;
    }
    .flip-card:hover .flip-rest,
    .flip-card:focus-within .flip-rest {
      pointer-events: none;
    }
  }
  .flip-card.is-flipped .flip-card-inner {
    transform: rotateY(180deg);
  }
  .flip-card.is-flipped .flip-info {
    pointer-events: auto;
  }
  .flip-card.is-flipped .flip-rest {
    pointer-events: none;
  }

  .flip-rest,
  .flip-info {
    position: absolute;
    inset: 0;
    border-radius: 1rem;
    overflow: hidden;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
    background: var(--color-espresso);
    color: var(--color-paper);
    box-shadow: var(--shadow-soft);
  }

  /* ---- Resting face: animated teal glow ring + floating blobs ---- */
  .flip-rest {
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .flip-rest::before {
    content: '';
    position: absolute;
    left: 50%;
    top: 50%;
    width: 200%;
    aspect-ratio: 1;
    translate: -50% -50%;
    background: linear-gradient(
      90deg,
      transparent 20%,
      var(--color-clay-500),
      var(--color-clay-300),
      var(--color-clay-500),
      transparent 80%
    );
    animation: flip-glow 5s linear infinite;
  }
  .flip-rest-content {
    position: absolute;
    inset: 2px;
    z-index: 1;
    border-radius: calc(1rem - 2px);
    background: var(--color-espresso);
    background-image: linear-gradient(160deg, var(--color-espresso-2), var(--color-espresso));
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.9rem;
    padding: 1.25rem;
    overflow: hidden;
  }
  .blob {
    position: absolute;
    border-radius: 9999px;
    filter: blur(20px);
    opacity: 0.5;
    animation: flip-float 2600ms ease-in-out infinite;
  }
  .blob-a {
    width: 6rem;
    height: 6rem;
    left: 12%;
    top: 22%;
    background: var(--color-clay-500);
  }
  .blob-b {
    width: 4.5rem;
    height: 4.5rem;
    right: 10%;
    bottom: 14%;
    background: var(--color-ochre-400);
    animation-delay: -800ms;
  }
  .flip-icon {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    height: 4rem;
    width: 4rem;
    border-radius: 1rem;
    color: var(--color-clay-300);
    background: rgba(255, 255, 255, 0.08);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.12);
  }
  .flip-title {
    position: relative;
    text-align: center;
    font-size: 1.05rem;
    font-weight: 700;
    line-height: 1.2;
  }
  .flip-hint {
    position: absolute;
    right: 0.85rem;
    bottom: 0.85rem;
    color: rgba(255, 255, 255, 0.4);
  }

  /* ---- Flipped face: details ---- */
  .flip-info {
    transform: rotateY(180deg);
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.5rem;
    padding: 1.4rem;
    background-image: linear-gradient(160deg, var(--color-espresso-2), var(--color-espresso));
  }
  .flip-info-title {
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--color-clay-300);
  }
  .flip-info-desc {
    font-size: 0.875rem;
    line-height: 1.55;
    color: rgba(255, 255, 255, 0.82);
  }
  .flip-info-cta {
    margin-top: 0.4rem;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-paper);
    transition: color var(--dur, 200ms) ease;
  }
  .flip-info-cta:hover {
    color: var(--color-clay-300);
  }

  @keyframes flip-glow {
    to {
      transform: rotate(360deg);
    }
  }
  @keyframes flip-float {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(10px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .flip-card-inner {
      transition: none;
    }
    .flip-rest::before,
    .blob {
      animation: none;
    }
  }
</style>

<script>
  // Touch devices have no hover, so tap toggles the flip (taps on the CTA link
  // pass through to navigate). Re-initialised on every Astro View Transition.
  function initFlipCards() {
    if (!window.matchMedia('(hover: none)').matches) return;
    document.querySelectorAll<HTMLElement>('.flip-card').forEach((card) => {
      if (card.dataset.bound === '1') return;
      card.dataset.bound = '1';
      card.addEventListener('click', (e) => {
        if ((e.target as HTMLElement).closest('a')) return;
        card.classList.toggle('is-flipped');
      });
    });
  }
  document.addEventListener('astro:page-load', initFlipCards);
</script>
