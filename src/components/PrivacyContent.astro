---
import { getLangFromUrl, useTranslations, useTranslatedPath } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const localize = useTranslatedPath(lang);
---

<article class="mx-auto max-w-3xl px-5 pb-24 pt-32 sm:px-8 sm:pt-36">
  <a
    href={localize()}
    class="link-underline inline-flex items-center gap-2 text-sm font-semibold text-clay-700"
  >
    <span aria-hidden="true">←</span>
    {t.privacy.backHome}
  </a>

  <h1 class="font-display mt-6 text-[clamp(2.2rem,5.5vw,3.5rem)] font-bold text-ink">
    {t.privacy.title}
  </h1>
  <p class="mt-3 text-sm text-ink-faint">{t.privacy.updatedLabel}: {t.privacy.updated}</p>
  <p class="mt-6 text-lg leading-relaxed text-ink-soft">{t.privacy.intro}</p>

  <div class="mt-10 space-y-9">
    {
      t.privacy.sections.map((section, i) => (
        <section class="reveal" style={`--reveal-delay:${i * 50}ms`}>
          <h2 class="font-display text-xl font-bold text-ink">{section.heading}</h2>
          <p class="mt-2.5 leading-relaxed text-ink-soft">{section.body}</p>
        </section>
      ))
    }
  </div>
</article>
