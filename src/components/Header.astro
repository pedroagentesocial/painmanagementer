---
import LanguageSelector from './LanguageSelector.astro';
import { getLangFromUrl, useTranslations, useTranslatedPath } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const localize = useTranslatedPath(lang);

const navItems = [
  { id: 'conditions', href: `${localize()}#conditions`, label: t.nav.conditions },
  { id: 'services', href: `${localize()}#services`, label: t.nav.services },
  { id: 'how', href: `${localize()}#how`, label: t.nav.how },
  { id: 'faq', href: `${localize()}#faq`, label: t.nav.faq },
];
---

<header
  id="site-header"
  class="site-header fixed inset-x-0 top-0 z-50 transition-colors duration-300"
>
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-3 px-5 py-3.5 sm:gap-6 sm:px-8">
    <a href={localize()} class="logo shrink-0" aria-label={t.site.name}>
      {/* Colour lockup for the solid header, white lockup for over the video. */}
      <img src="/logo-mark.png" alt={t.site.name} width="887" height="227" class="logo-color h-7 w-auto sm:h-9" />
      <img src="/logo-white.png" alt="" aria-hidden="true" width="887" height="227" class="logo-white h-7 w-auto sm:h-9" />
    </a>

    <nav aria-label="Primary" class="hidden lg:block">
      <ul role="list" class="nav-links flex items-center gap-6 text-sm font-medium">
        {
          navItems.map((item) => (
            <li>
              <a href={item.href} data-nav={item.id} class="nav-link link-underline transition-colors">
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="flex items-center gap-2 sm:gap-3">
      <LanguageSelector />
      <a
        href={`${localize()}#contact`}
        class="hidden min-h-11 items-center whitespace-nowrap rounded-full bg-clay-600 px-4 text-sm font-semibold text-paper shadow-sm transition-[background-color,transform] duration-200 ease-[cubic-bezier(0.25,1,0.5,1)] hover:bg-clay-700 active:scale-[0.98] lg:inline-flex"
      >
        {t.nav.book}
      </a>

      {/* Mobile menu toggle */}
      <button
        id="menu-toggle"
        type="button"
        class="menu-toggle flex h-11 w-11 items-center justify-center rounded-full lg:hidden"
        aria-label={t.nav.menu}
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg class="menu-icon-open h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16" />
        </svg>
        <svg class="menu-icon-close h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path d="M6 6l12 12M18 6L6 18" />
        </svg>
      </button>
    </div>
  </div>

  {/* Mobile menu panel */}
  <div id="mobile-menu" class="mobile-menu lg:hidden" inert>
    <nav aria-label="Mobile" class="mx-auto max-w-6xl px-5 pb-6 pt-2 sm:px-8">
      <ul role="list" class="flex flex-col">
        {
          navItems.map((item) => (
            <li class="border-b border-ink/8">
              <a
                href={item.href}
                data-nav={item.id}
                data-menu-link
                class="mobile-link flex items-center justify-between py-4 text-lg font-semibold text-ink transition-colors"
              >
                {item.label}
                <span class="text-clay-600" aria-hidden="true">→</span>
              </a>
            </li>
          ))
        }
      </ul>
      <a
        href={`${localize()}#contact`}
        data-menu-link
        class="mt-6 flex min-h-12 items-center justify-center rounded-full bg-clay-600 px-6 text-base font-semibold text-paper shadow-sm transition-colors hover:bg-clay-700"
      >
        {t.nav.book}
      </a>
    </nav>
  </div>
</header>

<style>
  /* Lock background scroll while the mobile menu is open. */
  :global(body:has(.site-header.menu-open)) {
    overflow: hidden;
  }

  /* --- Transparent state (default, over the hero video) --- */
  .site-header {
    background-color: transparent;
    border-bottom: 1px solid transparent;
  }
  .site-header .logo-color {
    display: none;
  }
  .site-header .nav-link {
    color: var(--color-paper);
  }
  .site-header .nav-link:hover,
  .site-header .nav-link.is-active {
    color: var(--color-clay-300);
  }
  .site-header .nav-link.is-active::after {
    transform: scaleX(1);
  }
  .menu-toggle {
    color: var(--color-paper);
  }

  /* --- Solid state (after the hero scrolls past) + open menu --- */
  .site-header.is-solid,
  .site-header.menu-open {
    background-color: color-mix(in srgb, var(--color-paper) 92%, transparent);
    border-bottom-color: color-mix(in srgb, var(--color-ink) 8%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }
  .site-header.is-solid .logo-color,
  .site-header.menu-open .logo-color {
    display: block;
  }
  .site-header.is-solid .logo-white,
  .site-header.menu-open .logo-white {
    display: none;
  }
  .site-header.is-solid .nav-link {
    color: var(--color-ink-soft);
  }
  .site-header.is-solid .nav-link:hover,
  .site-header.is-solid .nav-link.is-active {
    color: var(--color-clay-700);
  }
  .site-header.is-solid .menu-toggle,
  .site-header.menu-open .menu-toggle {
    color: var(--color-ink);
  }

  /* --- Mobile menu toggle icon swap --- */
  .menu-icon-close {
    display: none;
  }
  .site-header.menu-open .menu-icon-open {
    display: none;
  }
  .site-header.menu-open .menu-icon-close {
    display: block;
  }

  /* --- Mobile menu panel (animated) --- */
  .mobile-menu {
    overflow: hidden;
    max-height: 0;
    opacity: 0;
    background-color: var(--color-paper);
    border-top: 1px solid color-mix(in srgb, var(--color-ink) 6%, transparent);
    transition:
      max-height 320ms var(--ease-out-quart, ease),
      opacity 200ms ease;
  }
  .site-header.menu-open .mobile-menu {
    max-height: 80svh;
    overflow-y: auto;
    opacity: 1;
  }
  .mobile-link:hover {
    color: var(--color-clay-700);
  }
  .mobile-link.is-active {
    color: var(--color-clay-700);
  }

  @media (prefers-reduced-motion: reduce) {
    .mobile-menu {
      transition: none;
    }
  }
</style>

<script>
  // Header: transparent→solid over the hero, mobile menu, and scroll-spy that
  // highlights the section you're viewing. Re-initialised on every page load.
  function initHeader() {
    const header = document.getElementById('site-header');
    if (!header) return;

    // --- Mobile menu ---
    const toggle = document.getElementById('menu-toggle');
    const menu = document.getElementById('mobile-menu');
    const closeMenu = () => {
      header.classList.remove('menu-open');
      toggle?.setAttribute('aria-expanded', 'false');
      menu?.setAttribute('inert', '');
    };
    const openMenu = () => {
      header.classList.add('menu-open');
      toggle?.setAttribute('aria-expanded', 'true');
      menu?.removeAttribute('inert');
    };
    if (toggle && !toggle.dataset.bound) {
      toggle.dataset.bound = '1';
      toggle.addEventListener('click', () =>
        header.classList.contains('menu-open') ? closeMenu() : openMenu(),
      );
      menu?.querySelectorAll('[data-menu-link]').forEach((a) => a.addEventListener('click', closeMenu));
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') closeMenu();
      });
      window.addEventListener('resize', () => {
        if (window.innerWidth >= 1024) closeMenu();
      });
    }

    // --- Transparent → solid over the hero ---
    const hero = document.getElementById('hero');
    if (!hero) {
      header.classList.add('is-solid');
    } else {
      const io = new IntersectionObserver(
        ([entry]) => header.classList.toggle('is-solid', !entry.isIntersecting),
        { rootMargin: '-72px 0px 0px 0px', threshold: 0 },
      );
      io.observe(hero);
    }

    // --- Scroll-spy: highlight the active section in the nav ---
    const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-nav]'));
    const ids = [...new Set(links.map((l) => l.getAttribute('data-nav')))].filter(Boolean) as string[];
    const sections = ids
      .map((id) => document.getElementById(id))
      .filter((el): el is HTMLElement => Boolean(el));

    const setActive = (id: string) => {
      links.forEach((l) => {
        const on = l.getAttribute('data-nav') === id;
        l.classList.toggle('is-active', on);
        if (on) l.setAttribute('aria-current', 'true');
        else l.removeAttribute('aria-current');
      });
    };

    if (sections.length) {
      const spy = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) setActive((entry.target as HTMLElement).id);
          }
        },
        { rootMargin: '-45% 0px -50% 0px', threshold: 0 },
      );
      sections.forEach((s) => spy.observe(s));
    }
  }

  document.addEventListener('astro:page-load', initHeader);
</script>
