---
import Icon from './visual/Icon.astro';

interface Props {
  service: { idx: number; icon: string; visual: string; title: string; short: string };
  num: number;
  detailsCta: string;
}
const { service, num, detailsCta } = Astro.props;
---

<li
  class="reveal group relative flex flex-col overflow-hidden rounded-3xl border border-ink/10 bg-paper shadow-[var(--shadow-soft)] transition-[transform,box-shadow] duration-300 hover:-translate-y-1.5 hover:shadow-[var(--shadow-lift)]"
  style={`--reveal-delay:${((num - 1) % 3) * 80}ms`}
>
  {/* Branded visual header */}
  <div class="relative aspect-[16/10] overflow-hidden" style={`background-image:${service.visual}`}>
    <svg
      class="pointer-events-none absolute -right-10 -top-10 h-48 w-48 text-white/15 transition-transform duration-500 group-hover:scale-110"
      viewBox="0 0 200 200"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      aria-hidden="true"
    >
      <circle cx="150" cy="50" r="34"></circle>
      <circle cx="150" cy="50" r="62" stroke-opacity="0.7"></circle>
      <circle cx="150" cy="50" r="92" stroke-opacity="0.45"></circle>
    </svg>
    <span
      class="absolute left-4 top-4 rounded-full bg-white/15 px-3 py-1 text-xs font-semibold text-paper ring-1 ring-white/25 backdrop-blur-sm"
      aria-hidden="true"
    >
      {String(num).padStart(2, '0')}
    </span>
    <div class="absolute inset-0 flex items-center justify-center">
      <span class="flex h-16 w-16 items-center justify-center rounded-2xl bg-white/15 text-paper ring-1 ring-white/25 backdrop-blur-sm transition-transform duration-300 group-hover:scale-110">
        <Icon paths={service.icon} class="h-8 w-8" />
      </span>
    </div>
  </div>

  {/* Body */}
  <div class="flex flex-1 flex-col p-6">
    <h3 class="font-display text-xl font-bold text-ink">{service.title}</h3>
    <p class="mt-2 flex-1 text-sm leading-relaxed text-ink-soft">{service.short}</p>
    <button
      type="button"
      class="service-trigger mt-5 inline-flex items-center gap-2 text-sm font-semibold text-clay-700 transition-colors group-hover:text-clay-600"
      data-service={service.idx}
      aria-haspopup="dialog"
      aria-label={`${detailsCta}: ${service.title}`}
    >
      <span class="absolute inset-0" aria-hidden="true"></span>
      {detailsCta}
      <span class="transition-transform duration-200 group-hover:translate-x-1" aria-hidden="true">→</span>
    </button>
  </div>
</li>
