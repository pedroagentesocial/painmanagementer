---
import { getLangFromUrl, useTranslations, useTranslatedPath } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const localize = useTranslatedPath(lang);
const year = new Date().getFullYear();

const links = [
  { href: `${localize()}#conditions`, label: t.nav.conditions },
  { href: `${localize()}#treatments`, label: t.nav.treatments },
  { href: `${localize()}#how`, label: t.nav.how },
  { href: `${localize()}#contact`, label: t.nav.contact },
];
---

<footer class="bg-ink text-paper">
  <div class="mx-auto max-w-6xl px-5 py-14 sm:px-8">
    <div class="flex flex-col gap-10 sm:flex-row sm:items-start sm:justify-between">
      <div class="max-w-sm">
        <p class="font-display text-2xl">
          pain<span class="text-clay-400">managementer</span>
        </p>
        <p class="mt-3 text-sm text-paper/70">{t.footer.tagline}</p>
      </div>

      <nav aria-label="Footer">
        <ul role="list" class="-my-2.5 flex flex-wrap gap-x-6 text-sm">
          {
            links.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="inline-flex min-h-11 items-center text-paper/80 transition-colors hover:text-paper"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>

    <div class="mt-12 flex flex-col gap-3 border-t border-paper/15 pt-6 text-xs text-paper/55 sm:flex-row sm:items-center sm:justify-between">
      <p>© {year} {t.site.name}. {t.footer.rights}</p>
      <p class="max-w-md sm:text-right">{t.footer.disclaimer}</p>
    </div>
  </div>
</footer>
