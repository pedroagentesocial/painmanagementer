---
import SocialLinks from './SocialLinks.astro';
import { getLangFromUrl, useTranslations, useTranslatedPath } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const localize = useTranslatedPath(lang);
const privacyHref = lang === 'es' ? '/es/privacidad' : '/en/privacy';
const year = new Date().getFullYear();

const links = [
  { href: `${localize()}#conditions`, label: t.nav.conditions },
  { href: `${localize()}#services`, label: t.nav.services },
  { href: `${localize()}#how`, label: t.nav.how },
  { href: `${localize()}#faq`, label: t.nav.faq },
  { href: `${localize()}#contact`, label: t.nav.contact },
];
---

<footer class="bg-ink text-paper">
  <div class="mx-auto max-w-6xl px-5 py-14 sm:px-8">
    <div class="flex flex-col gap-10 sm:flex-row sm:items-start sm:justify-between">
      <div class="reveal max-w-sm">
        <p class="font-display text-2xl tracking-tight">
          PainManagement<span class="text-clay-400"> ER</span>
        </p>
        <p class="mt-3 text-sm text-paper/70">{t.footer.tagline}</p>

        <SocialLinks class="mt-6" />
      </div>

      <nav aria-label="Footer" class="reveal" style="--reveal-delay:80ms">
        <ul role="list" class="-my-2.5 grid grid-cols-2 gap-x-8 text-sm sm:flex sm:flex-col sm:gap-x-0">
          {
            links.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="inline-flex min-h-11 items-center text-paper/80 transition-colors hover:text-paper"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>

    <div class="reveal mt-12 flex flex-col gap-3 border-t border-paper/15 pt-6 text-xs text-paper/55 sm:flex-row sm:items-center sm:justify-between">
      <p class="flex flex-wrap items-center gap-x-3 gap-y-1">
        <span>© {year} {t.site.name}. {t.footer.rights}</span>
        <a href={privacyHref} class="underline-offset-2 transition-colors hover:text-paper hover:underline">
          {t.privacy.link}
        </a>
      </p>
      <p class="max-w-md sm:text-right">{t.footer.disclaimer}</p>
    </div>
  </div>
</footer>
