---
/**
 * Páginas de servicio (plan SEO, sección 3 del manual): una por intención de
 * búsqueda, armadas con el contenido que ya publica la portada — condiciones,
 * tratamientos, servicios y los pasos — más las guías del blog que tratan el
 * tema. Lo único escrito aquí son el título, la introducción y los encabezados;
 * ninguna afirmación médica nueva.
 */
import { getLangFromUrl, useTranslations, useTranslatedPath } from '../i18n/utils';
import { getPosts, postSlug } from '../lib/blog';
import { SERVICE_PAGES, type ServicePageId } from '../data/servicePages';

interface Props {
  id: ServicePageId;
}

const { id } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const localize = useTranslatedPath(lang);
const page = SERVICE_PAGES[id];
const copy = page.copy[lang];

/* Bloques de contenido, todos del diccionario del sitio. */
const tratamientos = t.treatments.items;
const servicios = page.services.map((i) => t.services.items[i]).filter(Boolean);
const condicion = page.condition !== undefined ? t.conditions.items[page.condition] : undefined;
const pasos = t.howItWorks.steps;

/* Guías del blog, en el orden pedido; solo las que existen en este idioma. */
const posts = await getPosts(lang);
const guias = page.guides
  .map((slug) => posts.find((p) => postSlug(p) === slug))
  .filter((p): p is NonNullable<typeof p> => Boolean(p));

const contacto = `${localize()}#contact`;
const otras = (Object.keys(SERVICE_PAGES) as ServicePageId[]).filter((k) => k !== id);
---

<article class="mx-auto max-w-6xl px-5 pb-24 pt-32 sm:px-8 sm:pt-36">
  <header class="max-w-3xl">
    <p class="font-display text-sm font-semibold uppercase tracking-[0.2em] text-clay-600">{copy.eyebrow}</p>
    <h1 class="font-display mt-4 text-[clamp(2.2rem,5.5vw,3.5rem)] font-bold leading-tight text-ink">{copy.h1}</h1>
    <p class="mt-6 text-lg leading-relaxed text-ink-soft">{copy.intro}</p>
    {condicion && (
      <p class="mt-4 text-lg leading-relaxed text-ink-soft">
        <strong class="text-ink">{condicion.title}:</strong> {condicion.description}
      </p>
    )}
    <div class="mt-8 flex flex-wrap gap-3">
      <a href={contacto} class="inline-flex items-center gap-2 rounded-full bg-ink px-8 py-4 text-base font-semibold text-paper transition-[background-color,transform] duration-200 hover:-translate-y-0.5 hover:bg-clay-700 active:translate-y-0">{t.treatments.cta}</a>
    </div>
  </header>

  {servicios.length > 0 && (
    <section class="mt-20">
      <h2 class="font-display text-[clamp(1.6rem,3.5vw,2.25rem)] font-bold text-ink">{copy.servicesTitle}</h2>
      <ul role="list" class="mt-8 grid gap-6 sm:grid-cols-2">
        {servicios.map((s) => (
          <li class="rounded-3xl border border-ink/8 bg-paper-2 p-7 shadow-soft">
            <h3 class="font-display text-xl font-bold text-ink">{s.title}</h3>
            <p class="mt-3 leading-relaxed text-ink-soft">{s.description}</p>
            <ul role="list" class="mt-4 space-y-1.5 text-sm text-ink-soft">
              {s.points.map((p) => <li>— {p}</li>)}
            </ul>
          </li>
        ))}
      </ul>
    </section>
  )}

  <section class="mt-20">
    <h2 class="font-display text-[clamp(1.6rem,3.5vw,2.25rem)] font-bold text-ink">{t.treatments.title}</h2>
    <p class="mt-3 max-w-2xl text-lg text-ink-soft">{t.treatments.subtitle}</p>
    <ul role="list" class="mt-8 grid gap-6 sm:grid-cols-2">
      {tratamientos.map((tr) => (
        <li class="rounded-3xl border border-ink/8 bg-paper-2 p-7 shadow-soft">
          <p class="text-xs font-semibold uppercase tracking-wide text-clay-700">{tr.tag}</p>
          <h3 class="font-display mt-2 text-xl font-bold text-ink">{tr.title}</h3>
          <p class="mt-3 leading-relaxed text-ink-soft">{tr.description}</p>
          <ul role="list" class="mt-4 space-y-1.5 text-sm text-ink-soft">
            {tr.points.map((p) => <li>— {p}</li>)}
          </ul>
        </li>
      ))}
    </ul>
  </section>

  {guias.length > 0 && (
    <section class="mt-20">
      <h2 class="font-display text-[clamp(1.6rem,3.5vw,2.25rem)] font-bold text-ink">{copy.guidesTitle}</h2>
      <ul role="list" class="mt-8 grid gap-4 sm:grid-cols-2">
        {guias.map((g) => (
          <li>
            <a
              href={`${localize(`blog/${postSlug(g)}`)}/`}
              class="group block h-full rounded-2xl border border-ink/8 p-6 transition-colors hover:border-clay-300"
            >
              <span class="font-display text-lg font-bold leading-snug text-ink group-hover:text-clay-700">{g.data.title}</span>
              <span class="mt-2 block text-sm leading-relaxed text-ink-soft">{g.data.description}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}

  <section class="mt-20">
    <h2 class="font-display text-[clamp(1.6rem,3.5vw,2.25rem)] font-bold text-ink">{t.howItWorks.title}</h2>
    <ol class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {pasos.map((p, i) => (
        <li class="rounded-3xl bg-paper-2 p-6">
          <span class="font-display text-3xl font-bold text-clay-600" aria-hidden="true">{i + 1}</span>
          <h3 class="font-display mt-2 text-lg font-bold text-ink">{p.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-ink-soft">{p.description}</p>
        </li>
      ))}
    </ol>
    <a href={contacto} class="mt-10 inline-flex items-center gap-2 rounded-full bg-ink px-8 py-4 text-base font-semibold text-paper transition-[background-color,transform] duration-200 hover:-translate-y-0.5 hover:bg-clay-700 active:translate-y-0">{t.howItWorks.cta}</a>
  </section>

  <nav aria-label={copy.moreLabel} class="mt-20 border-t border-ink/10 pt-10">
    <p class="text-sm font-semibold uppercase tracking-wide text-ink-faint">{copy.moreLabel}</p>
    <ul role="list" class="mt-4 flex flex-wrap gap-x-8 gap-y-3">
      {otras.map((k) => (
        <li><a href={`${localize(SERVICE_PAGES[k].slug[lang])}/`} class="font-semibold text-clay-700 underline underline-offset-4 hover:text-clay-600">{SERVICE_PAGES[k].copy[lang].h1}</a></li>
      ))}
      <li><a href={`${localize("blog")}/`} class="font-semibold text-clay-700 underline underline-offset-4 hover:text-clay-600">Blog</a></li>
    </ul>
  </nav>
</article>
