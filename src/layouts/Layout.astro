---
import '@fontsource-variable/sora';
import '@fontsource-variable/inter';
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

interface Props {
  title?: string;
  description?: string;
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const {
  title = `${t.site.name} — ${t.site.tagline}`,
  description = t.hero.subtitle,
} = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="theme-color" content="#ffffff" />
    {/* Smooth crossfade between locales (and any internal nav). */}
    <ClientRouter />
  </head>
  <body class="min-h-screen">
    <div class="grain-overlay" aria-hidden="true"></div>
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:rounded-lg focus:bg-ink focus:px-4 focus:py-2 focus:text-paper"
    >
      {t.a11y.skipToContent}
    </a>
    <Header />
    <main id="main-content" tabindex="-1" class="focus:outline-none">
      <slot />
    </main>
    <Footer />

    <script>
      // Reveal-on-scroll: opacity + transform only, degraded for reduced-motion
      // and no-JS. Re-runs on every View Transition via `astro:page-load`.
      // On SPA navigations (e.g. language switch) reveals appear instantly so
      // they don't stack a second animation on top of the page crossfade.
      function initReveals(firstLoad: boolean) {
        const els = document.querySelectorAll<HTMLElement>('.reveal');
        const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        if (!firstLoad || reduce || !('IntersectionObserver' in window)) {
          els.forEach((el) => el.classList.add('is-visible'));
          return;
        }
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                io.unobserve(entry.target);
              }
            }
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.12 },
        );
        els.forEach((el) => io.observe(el));
      }

      let firstLoad = true;
      document.addEventListener('astro:page-load', () => {
        initReveals(firstLoad);
        firstLoad = false;
      });
    </script>
    <noscript>
      <style>
        .reveal {
          opacity: 1 !important;
          transform: none !important;
        }
      </style>
    </noscript>
  </body>
</html>
