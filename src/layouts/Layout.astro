---
import '@fontsource-variable/sora';
import '@fontsource-variable/inter';
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Analytics from '@vercel/analytics/astro';
import SpeedInsights from '@vercel/speed-insights/astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getLangFromUrl, useTranslations, getLocalizedPathname } from '../i18n/utils';
import { contact } from '../data/site';

interface Props {
  title?: string;
  description?: string;
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const {
  title = `${t.site.name} — ${t.site.tagline}`,
  description = t.hero.slides[0].subtitle,
} = Astro.props;

// SEO: canonical + hreflang alternates + social image (absolute URLs).
const site = Astro.site ?? new URL('https://www.painmanagementer.com');
const canonical = new URL(Astro.url.pathname, site).href;
const esUrl = new URL(getLocalizedPathname(Astro.url.pathname, 'es'), site).href;
const enUrl = new URL(getLocalizedPathname(Astro.url.pathname, 'en'), site).href;
const ogImage = new URL('/images/hero1.jpg', site).href;

// Structured data — local clinic (helps local SEO + rich results).
const clinicLd = {
  '@context': 'https://schema.org',
  '@type': 'MedicalClinic',
  name: t.site.name,
  description: t.site.tagline,
  url: site.href,
  image: ogImage,
  telephone: contact.phone,
  email: contact.email,
  address: {
    '@type': 'PostalAddress',
    streetAddress: contact.addressLines[0],
    addressLocality: contact.addressLines[1],
    addressCountry: 'ES',
  },
  medicalSpecialty: 'PainMedicine',
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />

    {/* Canonical + bilingual hreflang alternates */}
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="es" href={esUrl} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="x-default" href={esUrl} />

    {/* Open Graph / social */}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={t.site.name} />
    <meta property="og:locale" content={lang === 'es' ? 'es_ES' : 'en_US'} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#ffffff" />

    {/* Structured data: local clinic */}
    <script type="application/ld+json" set:html={JSON.stringify(clinicLd)} is:inline />

    {/* Smooth crossfade between locales (and any internal nav). */}
    <ClientRouter />
  </head>
  <body class="min-h-screen">
    {/* Reading progress bar (fills as the page scrolls) */}
    <div id="scroll-progress" class="scroll-progress" aria-hidden="true"></div>
    <div class="grain-overlay" aria-hidden="true"></div>
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:rounded-lg focus:bg-ink focus:px-4 focus:py-2 focus:text-paper"
    >
      {t.a11y.skipToContent}
    </a>
    <Header />
    <main id="main-content" tabindex="-1" class="focus:outline-none">
      <slot />
    </main>
    <Footer />

    <script>
      // Reveal-on-scroll: opacity + transform only, degraded for reduced-motion
      // and no-JS. Re-runs on every View Transition via `astro:page-load`.
      // On SPA navigations (e.g. language switch) reveals appear instantly so
      // they don't stack a second animation on top of the page crossfade.
      function initReveals(firstLoad: boolean) {
        const els = document.querySelectorAll<HTMLElement>('.reveal');
        const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        if (!firstLoad || reduce || !('IntersectionObserver' in window)) {
          els.forEach((el) => el.classList.add('is-visible'));
          return;
        }
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                io.unobserve(entry.target);
              }
            }
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.12 },
        );
        els.forEach((el) => io.observe(el));
      }

      let firstLoad = true;
      document.addEventListener('astro:page-load', () => {
        initReveals(firstLoad);
        firstLoad = false;
      });
    </script>

    <script>
      // Reading-progress bar: scaleX driven by scroll position (rAF-throttled).
      // Single scroll listener, re-pointed on each View Transition.
      let progressHandler: (() => void) | null = null;
      function initScrollProgress() {
        const bar = document.getElementById('scroll-progress');
        if (!bar) return;
        let ticking = false;
        const update = () => {
          ticking = false;
          const doc = document.documentElement;
          const max = doc.scrollHeight - doc.clientHeight;
          const p = max > 0 ? Math.min(window.scrollY / max, 1) : 0;
          bar.style.transform = `scaleX(${p})`;
        };
        const onScroll = () => {
          if (!ticking) {
            ticking = true;
            requestAnimationFrame(update);
          }
        };
        if (progressHandler) window.removeEventListener('scroll', progressHandler);
        progressHandler = onScroll;
        window.addEventListener('scroll', progressHandler, { passive: true });
        update();
      }
      document.addEventListener('astro:page-load', initScrollProgress);
    </script>

    <Analytics />
    <SpeedInsights />
    <noscript>
      <style>
        .reveal {
          opacity: 1 !important;
          transform: none !important;
        }
      </style>
    </noscript>
  </body>
</html>
