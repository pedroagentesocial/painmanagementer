---
// Identical to /es/ — the component tree is language-agnostic. All text comes
// from the dictionary selected by the URL locale.
export const prerender = false;

import Layout from '../../layouts/Layout.astro';
import Hero from '../../components/sections/Hero.astro';
import Conditions from '../../components/sections/Conditions.astro';
import Treatments from '../../components/sections/Treatments.astro';
import Services from '../../components/sections/Services.astro';
import WhyUs from '../../components/sections/WhyUs.astro';
import HowItWorks from '../../components/sections/HowItWorks.astro';
import Testimonials from '../../components/sections/Testimonials.astro';
import Faq from '../../components/sections/Faq.astro';
import ContactLogistics from '../../components/sections/ContactLogistics.astro';
---

<Layout>
  <Hero />
  <Conditions />
  <Treatments />
  <Services />
  <WhyUs />
  <HowItWorks />
  <Testimonials />
  <Faq />
  <ContactLogistics />
</Layout>
